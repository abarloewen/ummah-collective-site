{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/profile.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Ummah-Collective-Company-Profile-2026.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ummah-hub",
      "destination": "/ummah-hub.html"
    },
    {
      "source": "/ummah-hub/",
      "destination": "/ummah-hub.html"
    },
    {
      "source": "/de/ummah-hub",
      "destination": "/de/ummah-hub.html"
    },
    {
      "source": "/de/ummah-hub/",
      "destination": "/de/ummah-hub.html"
    },
    {
      "source": "/de/service-custom-crm.html",
      "destination": "/service-custom-crm.html"
    },
    {
      "source": "/ms/service-custom-crm.html",
      "destination": "/service-custom-crm.html"
    },
    {
      "source": "/ar/service-custom-crm.html",
      "destination": "/service-custom-crm.html"
    },
    {
      "source": "/zh/service-custom-crm.html",
      "destination": "/service-custom-crm.html"
    },
    {
      "source": "/tr/service-custom-crm.html",
      "destination": "/service-custom-crm.html"
    }
  ],
  "redirects": [
    {
      "source": "/project-dolezel.html",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/:lang(ar|de|ms|tr|zh)/project-dolezel.html",
      "destination": "/:lang/work.html",
      "permanent": true
    },
    {
      "source": "/project-dig-it-company.html",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/de/project-dig-it-company.html",
      "destination": "/de/work.html",
      "permanent": true
    },
    {
      "source": "/ms/project-dig-it-company.html",
      "destination": "/ms/work.html",
      "permanent": true
    },
    {
      "source": "/ar/project-dig-it-company.html",
      "destination": "/ar/work.html",
      "permanent": true
    },
    {
      "source": "/zh/project-dig-it-company.html",
      "destination": "/zh/work.html",
      "permanent": true
    },
    {
      "source": "/tr/project-dig-it-company.html",
      "destination": "/tr/work.html",
      "permanent": true
    }
  ]
}
